.DS_Store
.gitignore
node_modules
public
prof
tsconfig.tsbuildinfo
.obsidian
.quartz-cache
private/
.replit
replit.nix

# Raw staging and archives (videos, PDFs, slides)
inbox/*
!inbox/README.md
archive/*
!archive/README.md
raw/*
!raw/README.md

# Google Classroom Scraper session, tokens, and outputs
gclass_scraping/.session/
gclass_scraping/state.json
gclass_scraping/.scrapling_cache/
gclass_scraping/output/
gclass_scraping/**/__pycache__/

# Ephemeral agent teamwork artifacts
.agents/teamwork/

# Temporary Office and lock files
~$*
*.tmp

# Build artifacts, binaries, and Python caches
target/
**/target/
*.exe
__pycache__/
**/__pycache__/
*.pyc

# Local editor/agent hooks
.github/hooks/
